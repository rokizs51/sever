# ── Supabase (required — auth + database; app is useless without these) ──
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
#   ↑ Supabase dashboard → Project Settings → API Keys / URL.
#   No service-role key needed anywhere — the code deliberately uses
#   session-scoped clients + RLS only.

# ── Canonical site origin (required in production) ──
NEXT_PUBLIC_SITE_URL=https://your-domain.example
#   Absolutizes sitemap/robots/OG URLs; defaults to http://localhost:3000 in dev.

# ── AI provider — your Qwen plan, Anthropic-compatible endpoint (Path A) ──
AI_PROVIDER=qwen
#   AI_BASE_URL must end at the version segment — the Anthropic SDK appends
#   "/messages" itself, so include "/v1" (e.g. .../apps/anthropic/v1).
#   A base without /v1 reaches the gateway's catch-all and fails with
#   404 InvalidParameter "Not support".
AI_BASE_URL=<Qwen plan's Anthropic-compatible base URL, ending in /v1>
AI_API_KEY=<Qwen plan API key>
AI_MODEL_EXTRACTION=<cheaper model id your plan serves>
AI_MODEL_ENHANCE=<stronger model id your plan serves>

# ── Optional (defaults are fine) ──
# AI_MONTHLY_COST_MICROUSD_CEILING=2000000   # global breaker, $2/mo equivalent
# PRICING_JSON=...                            # leave unset on a prepaid plan